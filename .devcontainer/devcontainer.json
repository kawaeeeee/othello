{
    "name": "Othello Web App Dev Container",
    "dockerComposeFile": [
      "../docker-compose.yml"
    ],
    "service": "app",
    "workspaceFolder": "/workspace",
    "customizations": {
      "vscode": {
        "settings": {
            "python.linting.enabled": true,
            "python.linting.lintOnSave": true,
            // Pylance
            "python.languageServer": "Pylance",
            "python.analysis.completeFunctionParens": true,
            // Linter(flake8)
            "python.linting.flake8Path": "/usr/local/bin/flake8",
            "python.linting.pylintEnabled": false,
            "python.linting.flake8Enabled": true,
            // Formatter(black)
            "python.formatting.blackPath": "/usr/local/bin/black",
            "python.formatting.provider": "black",
            "python.formatting.blackArgs": [
                "--line-length=79"
            ],
            "[python]": {
                "editor.formatOnSave": true
            }
		},
        "extensions": [
            "ms-python.python",          // Python拡張機能
            "ms-python.vscode-pylint",   // Pylint (Linter)
            "charliermarsh.ruff",        // Ruff (Formatter/Linter)
            "esbenp.prettier-vscode",    // Prettier (Formatter)
            "dbaeumer.vscode-eslint",    // ESLint (JavaScript/TypeScript Linter)
            "bradlc.vscode-tailwindcss", // Tailwind CSS IntelliSense (もしTailwind CSSを使うなら)
            "ms-azuretools.vscode-docker", // Docker拡張機能
            "mhutchie.git-graph",
            "GitHub.copilot"
            // その他の必要な拡張機能
        ]
      }
    }
    // "forwardPorts": [
    //   8000, // FastAPIのデフォルトポート
    //   3000  // Next.jsのデフォルトポート
    // ],
    // "postCreateCommand": [
    //   "cd backend && poetry install",
    //   "cd frontend && yarn install"
    // ]
  }